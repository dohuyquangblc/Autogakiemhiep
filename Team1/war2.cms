#name("warclone3") 
#autorun    
Getscreen
$tk = TFREAD("taikhoan\\taikhoan.txt",3)
$wnd1 = wndfind($tk)
$x = 0
$y =345
$d=500
$r=350
WNDSETINFO($wnd1,$x,$y,$d,$r) 
$vk = TFREAD("ht\\gocvk.txt",1)
$reg = TFREAD("ht\\checkrg.txt",1)
$Guild = TFREAD("ht\\Guild.txt",1)
$Clone = TFREAD("ht\\soluongclone.txt",1)
$nhatky = STRCONCAT($tk," Win:  ", $Win , " lose:  ", $lose)
hsettext($wnd1,$nhatky)
hset($wnd1,1)
waitms(10)
LCLICK(1,1)

//----------------------relog 500x350-------------------------------
//-----------Auo relog----------------


THREAD(relog, 1)
$Lmh = $Lmh + 1    
//LOGWRITE("time relog: ", $Lmh)
waitms(1000)  
END_THREAD


//thoi gian relog bao nhieu phut
$time = TFREAD("ht\\time.txt",1)
$time2 = $time*60

if($Lmh >= $time2)
   POSTMESSAGE($wnd1,0x0010,0,0)
   print("loi mkn sau ... phut" )
																		
$Lmh = 0
$re=$re+1
   wait(3)
   end_if
   
 //-----------Auo relog----------------

   //loi mat ket noi
if_pixel_in(178,151,178,151,10538208)
$loimkn = $loimkn + 1
print("loi mat ket noi " $loimkn)
waitms(1000)   
if($loimkn  >= 10)
   POSTMESSAGE($wnd1,0x0010,0,0)
   wait(3)
    $loimkn = 0
print("loi mat ket noi")
$re=$re+1
end_if
end_if	  



