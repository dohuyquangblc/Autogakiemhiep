   // 2. Xử lý phòng game
   IF($clone = 1)
      GETSCREEN
      
      // BƯỚC 2A: Nếu ô còn TRỐNG -> Tiến hành mời clone
      IF(PXL(159,98) = 11153494) 
         IF($Guild = 2)                                
            $m = 223
         ELSE
            $m = 254
         END_IF
         
         WAITMS(1000)
         LCLICK(149,69)  // khóa ô
         WAITMS(1000)
         LCLICK(149,69)  // mở ô

         WAITMS(1000)
         LCLICK(382,256)  // mời bạn
         WAITMS(1000)

         LCLICK($m,90) // bạn bè
         WAITMS(1000)

         LCLICK(277,106)  // click mời clone
         WAITMS(1000)
         LCLICK(299,72)
         WAITMS(1000)
         KEYPRESS(#ESC)
         WAITMS(1000)
      END_IF

      // BƯỚC 2B: Kiểm tra nếu clone ĐÃ VÀO PHÒNG (màu khác màu ô trống) -> Bấm bắt đầu
      GETSCREEN
      IF(PXL(159,98) != 11153494) 
         LOGWRITE("batdau vs clone2")
         LCLICK(455,253)  // Bắt đầu
         WAITMS(1000)
         $turn = 0
      END_IF

   ELSE
      // Trường hợp đánh 1 mình ($clone = 0)
      LOGWRITE("batdau 1 minh")
      LCLICK(455,253)  // Bắt đầu
      WAITMS(1000)
      $turn = 0
   END_IF

END_IF



